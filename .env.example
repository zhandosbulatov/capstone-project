# Google Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Copy this file to .env.local and fill it in. Server-only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: override the main models if Google renames or retires them.
# Defaults: gemini-3.5-flash-lite for drafting and chat, gemini-3.6-flash for screenshot checks.
# GEMINI_TEXT_MODEL=
# GEMINI_VISION_MODEL=
